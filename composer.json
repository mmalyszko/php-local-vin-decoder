{
  "name": "mmalyszko/php-local-vin-decoder",
  "description": "Lightweight VIN decoder for PHP 8+. Decodes a vehicle's brand, model, year, country and region from its VIN, locally and without external API calls.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "VinDecoder\\": "src/VinDecoder/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VinDecoder\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpstan analyse src --level=5",
    "test": "phpunit",
    "test:cover": "XDEBUG_MODE=coverage phpunit --coverage-html coverage",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff"
  }
}
